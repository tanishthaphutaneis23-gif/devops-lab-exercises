pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                sh 'cp -R /var/jenkins_lab/exercise-09-jenkins-pipeline "$WORKSPACE/exercise-09-jenkins-pipeline"'
            }
        }
        stage('Build') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/pip install --disable-pip-version-check -r requirements.txt'
                }
            }
        }
        stage('Test') {
            steps {
                dir('exercise-09-jenkins-pipeline') {
                    sh '.venv/bin/python -m unittest discover -s . -v'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp exercise-09-jenkins-pipeline/app.py exercise-09-jenkins-pipeline/requirements.txt "$WORKSPACE/python-app-deploy/"
                '''
            }
        }
    }
}
