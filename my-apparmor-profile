# Profile intended for the python interpreter inside the official Python image.
# Load this profile on a Linux host with AppArmor enabled before using it with Docker.
abi <abi/4.0>,
include <tunables/global>

/usr/local/bin/python flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network inet stream,
  capability net_bind_service,
  deny capability sys_admin,

  /app/** rw,
  /usr/local/bin/python rix,
  /usr/local/lib/python3.12/** r,
  /usr/local/lib/python3.12/**.so* mr,
  deny /etc/** rwklx,
  deny /var/** rwklx,
  deny /bin/** x,
  deny /usr/bin/** x,
}
