
pipeline {
    agent any

    stages {
        stage('Hello World') {
            steps {
                dir('exercise-08-jenkins-job') {
                    sh 'chmod +x hello-world.sh'
                    sh './hello-world.sh'
                }
            }
        }
    }

    post {
        success {
            echo 'Hello World job completed successfully.'
        }
        failure {
            echo 'Hello World job failed. Review the console output.'
        }
    }
}
