include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network inet stream,
  capability net_bind_service,
  deny capability sys_admin,

  /app/** r,
  /tmp/** rw,
  /usr/local/bin/python rix,
  /usr/local/bin/python3.12 rix,
  /usr/local/lib/python3.12/** r,
  /usr/local/lib/python3.12/**.so* mr,
  deny /etc/** wklx,
  deny /var/** wklx,
  deny /bin/** x,
  deny /usr/bin/** x,
  deny /etc/passwd r,
  deny /etc/shadow r,
}
